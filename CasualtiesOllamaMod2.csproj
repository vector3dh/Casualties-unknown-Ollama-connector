<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GamePath>D:\SteamLibrary\steamapps\common\Casualties Unknown Demo</GamePath>
    <ManagedPath>$(GamePath)\CasualtiesUnknown_Data\Managed</ManagedPath>
    <BepInExCore>$(GamePath)\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>CasualtiesOllamaMod2</AssemblyName>
    <RootNamespace>CasualtiesOllama</RootNamespace>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DebugType>none</DebugType>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>CS0649;CS0169;CS0414;CS8632;CS0108</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx + Harmony -->
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)\0Harmony.dll</HintPath><Private>false</Private></Reference>

    <!-- Game & Unity DLLs -->
    <Reference Include="$(ManagedPath)\Assembly-CSharp.dll"><Private>false</Private></Reference>
    <Reference Include="$(ManagedPath)\UnityEngine*.dll"><Private>false</Private></Reference>
    <Reference Include="$(ManagedPath)\Unity.*.dll"><Private>false</Private></Reference>
    <Reference Include="$(ManagedPath)\Newtonsoft.Json.dll"><Private>false</Private></Reference>
  </ItemGroup>

  <!-- The multiplayer mod is NOT referenced: it is accessed through reflection, so this mod works with or without it. -->

  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="Exists('$(GamePath)\BepInEx\plugins')">
    <Copy SourceFiles="$(OutDir)CasualtiesOllamaMod2.dll" DestinationFolder="$(GamePath)\BepInEx\plugins" />
    <Message Importance="high" Text="Copied CasualtiesOllamaMod2.dll to $(GamePath)\BepInEx\plugins  (delete the OLD CasualtiesOllamaMod.dll from that folder!)" />
  </Target>

</Project>
